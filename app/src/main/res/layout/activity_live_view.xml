<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Lecteur vidéo ExoPlayer -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit"/>

    <!-- Indicateur de chargement -->
    <ProgressBar
        android:id="@+id/progress_buffering"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:indeterminateTint="@color/accent_orange"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Message d'erreur -->
    <TextView
        android:id="@+id/tv_error"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/white"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="24dp"
        android:background="#88000000"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Contrôles du haut -->
    <LinearLayout
        android:id="@+id/controls_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@drawable/gradient_top"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@android:color/transparent"
            android:contentDescription="Retour"/>

        <TextView
            android:id="@+id/tv_stream_url"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="rtsp://..."
            android:textColor="#AAFFFFFF"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:layout_marginStart="8dp"/>

        <ImageButton
            android:id="@+id/btn_mute"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_volume_on"
            android:background="@android:color/transparent"
            android:contentDescription="Mute"/>

        <ImageButton
            android:id="@+id/btn_fullscreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_fullscreen"
            android:background="@android:color/transparent"
            android:contentDescription="Plein écran"/>

    </LinearLayout>

    <!-- Contrôles du bas -->
    <LinearLayout
        android:id="@+id/controls_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@drawable/gradient_bottom"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Bouton enregistrement -->
        <ImageButton
            android:id="@+id/btn_record"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_record"
            android:background="@drawable/circle_button_bg"
            android:contentDescription="Enregistrer"/>

        <!-- Timer d'enregistrement -->
        <TextView
            android:id="@+id/tv_record_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:layout_marginStart="16dp"
            android:layout_weight="1"/>

        <!-- Snapshot -->
        <ImageButton
            android:id="@+id/btn_snapshot"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_camera"
            android:background="@drawable/circle_button_bg_small"
            android:contentDescription="Capture"/>

    </LinearLayout>

    <!-- Indicateur REC -->
    <LinearLayout
        android:id="@+id/recording_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#CC000000"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="12dp">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/red_dot"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REC"
            android:textColor="@color/accent_red"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
