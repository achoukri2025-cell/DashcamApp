<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    android:layout_margin="5dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Miniature -->
        <ImageView
            android:id="@+id/iv_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:scaleType="centerCrop"
            android:background="@color/black"/>

        <!-- Icône play -->
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_play_circle"
            android:layout_centerInParent="true"
            android:layout_above="@id/ll_bottom"/>

        <!-- Badge durée -->
        <TextView
            android:id="@+id/tv_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:background="#AA000000"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            android:layout_alignBottom="@id/iv_thumbnail"
            android:layout_alignEnd="@id/iv_thumbnail"
            android:layout_marginBottom="4dp"
            android:layout_marginEnd="4dp"/>

        <!-- Badge REC local -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" LOCAL "
            android:textColor="@color/white"
            android:textSize="9sp"
            android:fontFamily="sans-serif-medium"
            android:background="@color/accent_orange"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:layout_alignTop="@id/iv_thumbnail"
            android:layout_alignStart="@id/iv_thumbnail"
            android:layout_marginTop="6dp"
            android:layout_marginStart="6dp"/>

        <!-- Infos bas -->
        <LinearLayout
            android:id="@+id/ll_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="9dp"
            android:layout_below="@id/iv_thumbnail">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DASHCAM_20240101.mp4"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="middle"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="3dp">

                <TextView
                    android:id="@+id/tv_size"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="— MB"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"/>
            </LinearLayout>

            <!-- Boutons action -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_share"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="↑ Partager"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:backgroundTint="@color/card_bg2"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btn_delete"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="🗑 Supprimer"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:backgroundTint="@color/accent_red"
                    android:textColor="@color/white"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
